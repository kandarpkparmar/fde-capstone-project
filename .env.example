# Copy to .env and fill in your own key. .env is git-ignored. Never commit a real key.
OPENROUTER_API_KEY=your_key_here
MODEL_NAME=meta-llama/llama-3.1-8b-instruct
EMBEDDING_MODEL=all-MiniLM-L6-v2

CHROMA_PATH=./storage/chroma
DATABASE_URL=sqlite:///./storage/decisions.db

LOG_LEVEL=INFO
# Routing thresholds, determined from data (docs/decisions.md D-03)
CONFIDENCE_THRESHOLD=0.80
ANSWERABLE_THRESHOLD=0.50
RETRIEVAL_TOP_K=4
# Optional: enables POST /admin/kill-switch
ADMIN_TOKEN=change_me
# Set LLM_ENABLED=0 to run fully offline (template answers only)
LLM_ENABLED=1
